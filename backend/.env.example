# Google AI Studio key -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Pinecone -- https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key

# Name of the Pinecone index. Create it with the cosine metric and a dimension
# equal to the embedding model output (gemini-embedding-001 returns 3072 values
# by default). See README > Setup for how to confirm the dimension.
PINECONE_INDEX_NAME=ragg-index

# Optional
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Retrieval tuning (optional). See README > Retrieval calibration.
# 0.4 barely filters anything with gemini-embedding-001; 0.6 is a better floor.
MIN_SCORE=0.4
MAX_CONTEXT_CHUNKS=3
